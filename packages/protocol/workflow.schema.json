{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiverse.dev/schemas/atlas/1.0/workflow.schema.json",
  "title": "Atlas Structured Workflow v1.0",
  "type": "object",
  "required": ["name", "version", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "start_path": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["navigate", "click", "fill", "search", "wait", "read", "screenshot", "assert"]
          },
          "path": { "type": "string" },
          "selector": { "type": "string" },
          "value": { "type": "string" },
          "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
          "expected_text": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    }
  }
}
