# =============================================================================
# Multiverse Environment Configuration
# =============================================================================
# Copy this file to .env and fill in generated secrets / Flagsmith tokens.
# Run `python scripts/generate_secrets.py` to generate local dev secrets & Ed25519 keys.

APP_ENV=development
APP_BASE_URL=http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:8001
VITE_API_URL=http://localhost:8001
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Comma-separated deployed frontend origins. Never use * with cookie sessions.
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local/private-network origins are allowed by default for development.
ALLOWED_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})(?::\d+)?$

# Security & Sessions (generate with `python scripts/generate_secrets.py`)
SESSION_SECRET=
AUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Multiverse Database (MySQL in Docker/Prod; SQLite fallback for local unit/dev)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=multiverse
MYSQL_USER=multiverse
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql+pymysql://multiverse:CHANGE_ME@mysql:3306/multiverse

# Redis (RQ background workers + runtime cache)
REDIS_URL=redis://redis:6379/0

# Self-Hosted Flagsmith
FLAGSMITH_API_URL=http://flagsmith:8000/api/v1/
FLAGSMITH_HOST_URL=http://localhost:8000/api/v1/
FLAGSMITH_MANAGEMENT_API_TOKEN=
FLAGSMITH_SHOP_ENV_KEY=
FLAGSMITH_LEARNING_ENV_KEY=
FLAGSMITH_WORKSPACE_ENV_KEY=

# Flagsmith Self-Hosted Postgres
FLAGSMITH_DB_USER=postgres
FLAGSMITH_DB_PASSWORD=
FLAGSMITH_DB_NAME=flagsmith
FLAGSMITH_SECRET_KEY=

# Passport Ed25519 Signing Keys
PASSPORT_PRIVATE_KEY_PATH=./infra/keys/passport_ed25519.pem
PASSPORT_PUBLIC_KEY_PATH=./infra/keys/passport_ed25519.pub.pem
PASSPORT_ISSUER=multiverse
PASSPORT_KEY_ID=multiverse-key-01

# Atlas Exploration Worker
EXPLORATION_MAX_CONCURRENCY=2
EXPLORATION_DEFAULT_BUDGET=64
EXPLORATION_TIMEOUT_SECONDS=120
ARTIFACT_STORAGE_PATH=./data/artifacts

# Registered Demo Application Targets (explicit SSRF allowlist)
DEMO_SHOP_URL=http://localhost:5173/demo/shop
DEMO_LEARNING_URL=http://localhost:5173/demo/learn
DEMO_WORKSPACE_URL=http://localhost:5173/demo/workspace
ALLOWED_EXPLORATION_ORIGINS=http://localhost:5173,http://web:5173,http://127.0.0.1:5173

# Tinker / Thinking Machines Lab (server-side only)
TINKER_API_KEY=
TINKER_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
TINKER_MODEL=thinkingmachines/Inkling:peft:262144
